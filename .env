SECRET_KEY=c281d443522eab0302357e7d97f24e91ae2083ebf8530905ee074ccfbfffe62f
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# "Sign in with Google" OAuth 2.0 Web client ID (Google Cloud Console -> APIs
# & Services -> Credentials). Authorized JavaScript origins must list every
# origin the app is served from (e.g. http://localhost:8000 for dev, the
# Railway URL for prod); no redirect URI is needed for Google Identity
# Services.
#
# This is only the fallback DEFAULT — like DATABASE_URL. The feature is
# switched on and the client ID is set from Admin -> System -> "Google
# Sign-In" (stored in DATA_GENERAL/SETTINGS.json, which overrides this and
# takes effect with no restart). While that toggle is off the button stays
# hidden and the /api/auth/google* routes return 503, regardless of this value.
GOOGLE_CLIENT_ID=

# Local Postgres (ga-postgres Docker container) — used only when the
# Admin -> System -> "Use JSON" toggle (use_json in
# DATA_GENERAL/SETTINGS.json) is off. Railway will supply its own
# DATABASE_URL at deploy time; this value is for local dev only.
DATABASE_URL=postgresql+psycopg2://postgres:devpass@localhost:5432/ga_library
